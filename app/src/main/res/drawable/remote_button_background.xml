<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <!-- Rounded corners like real remote buttons -->
            <corners android:radius="12dp" />

            <!-- Gradient for 3D effect -->
            <gradient
                android:angle="270"
                android:endColor="#2C3E50"
                android:startColor="#34495E"
                android:type="linear" />

            <!-- Subtle stroke -->
            <stroke
                android:width="1dp"
                android:color="#1A000000" />

            <!-- Padding -->
            <padding
                android:bottom="8dp"
                android:left="12dp"
                android:right="12dp"
                android:top="8dp" />
        </shape>
    </item>
</ripple>
