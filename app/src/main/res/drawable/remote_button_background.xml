<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <layer-list>
            <!-- Shadow/Bottom layer -->
            <item
                android:left="0dp"
                android:top="3dp"
                android:right="0dp"
                android:bottom="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#20000000" />
                </shape>
            </item>

            <!-- Main button body -->
            <item
                android:left="0dp"
                android:top="0dp"
                android:right="0dp"
                android:bottom="3dp">
                <shape android:shape="rectangle">
                    <!-- More rounded corners like real remote buttons -->
                    <corners android:radius="16dp" />

                    <!-- Strong gradient for 3D raised effect -->
                    <gradient
                        android:angle="270"
                        android:startColor="#4A5F7F"
                        android:centerColor="#34495E"
                        android:endColor="#2C3E50"
                        android:type="linear" />

                    <!-- Border for definition -->
                    <stroke
                        android:width="2dp"
                        android:color="#1A000000" />

                    <!-- Padding - reduced for better icon fit -->
                    <padding
                        android:bottom="4dp"
                        android:left="4dp"
                        android:right="4dp"
                        android:top="4dp" />
                </shape>
            </item>

            <!-- Top highlight for glossy effect -->
            <item
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="40dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#20FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
