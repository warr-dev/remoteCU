<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed button appears pushed in - no shadow on top -->
    <item
        android:left="0dp"
        android:top="2dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <!-- Rounded corners -->
            <corners android:radius="16dp" />

            <!-- Inverted gradient - appears pushed in -->
            <gradient
                android:angle="270"
                android:startColor="#1A252F"
                android:centerColor="#243447"
                android:endColor="#2C3E50"
                android:type="linear" />

            <!-- Stronger border when pressed -->
            <stroke
                android:width="2dp"
                android:color="#30000000" />

            <!-- Padding - reduced for better icon fit -->
            <padding
                android:bottom="4dp"
                android:left="4dp"
                android:right="4dp"
                android:top="4dp" />
        </shape>
    </item>

    <!-- Inner shadow for pressed effect -->
    <item
        android:left="4dp"
        android:top="6dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#10000000" />
        </shape>
    </item>
</layer-list>
