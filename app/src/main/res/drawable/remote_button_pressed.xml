<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Rounded corners -->
    <corners android:radius="12dp" />

    <!-- Darker gradient when pressed -->
    <gradient
        android:angle="270"
        android:endColor="#1A252F"
        android:startColor="#243447"
        android:type="linear" />

    <!-- Stroke -->
    <stroke
        android:width="1dp"
        android:color="#1A000000" />

    <!-- Padding -->
    <padding
        android:bottom="8dp"
        android:left="12dp"
        android:right="12dp"
        android:top="8dp" />
</shape>
