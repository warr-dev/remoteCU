<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardElevation="2dp"
    app:cardCornerRadius="8dp"
    app:cardBackgroundColor="@color/remoteCU_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Profile Icon -->
        <TextView
            android:id="@+id/profileIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="📺"
            android:textSize="32sp"
            android:gravity="center"
            android:background="@color/remoteCU_background"
            android:layout_marginEnd="16dp"/>

        <!-- Profile Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/profileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TV Remote"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/remoteCU_text_primary"/>

            <TextView
                android:id="@+id/profileButtonCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12 buttons"
                android:textSize="12sp"
                android:textColor="@color/remoteCU_text_secondary"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <!-- Active Indicator -->
        <TextView
            android:id="@+id/activeIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓"
            android:textSize="24sp"
            android:textColor="@color/remoteCU_success"
            android:visibility="gone"/>

        <!-- Edit/Delete Menu -->
        <ImageView
            android:id="@+id/profileMenuIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_more"
            android:layout_marginStart="8dp"
            android:contentDescription="Profile options"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
