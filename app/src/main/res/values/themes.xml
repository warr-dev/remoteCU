<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with RemoteCU branding -->
    <style name="Theme.RemoteCu" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/remoteCU_primary</item>
        <item name="colorPrimaryVariant">@color/remoteCU_primary_dark</item>
        <item name="colorOnPrimary">@color/remoteCU_text_on_primary</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/remoteCU_accent</item>
        <item name="colorSecondaryVariant">@color/remoteCU_accent_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Background colors -->
        <item name="android:colorBackground">@color/remoteCU_background</item>
        <item name="colorSurface">@color/remoteCU_surface</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/remoteCU_primary_dark</item>
        <!-- Action bar -->
        <item name="actionBarStyle">@style/RemoteCu.ActionBar</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.RemoteCu.Splash" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/remoteCU_primary_dark</item>
        <item name="android:navigationBarColor">@color/remoteCU_primary_dark</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <!-- Custom ActionBar Style -->
    <style name="RemoteCu.ActionBar" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="background">@color/remoteCU_primary</item>
        <item name="titleTextStyle">@style/RemoteCu.ActionBar.TitleText</item>
    </style>

    <style name="RemoteCu.ActionBar.TitleText" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>