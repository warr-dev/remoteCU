{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Android: Build Debug APK",
            "type": "shell",
            "command": "./gradlew.bat",
            "args": [
                "assembleDebug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Android: Install Debug APK",
            "type": "shell",
            "command": "./gradlew.bat",
            "args": [
                "installDebug"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Android: Build and Install",
            "type": "shell",
            "command": "./gradlew.bat",
            "args": [
                "assembleDebug",
                "installDebug"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Android: Build, Install and Run",
            "type": "shell",
            "command": "./gradlew.bat",
            "args": [
                "assembleDebug",
                "installDebug",
                "--console=plain"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Android: Launch App",
            "type": "shell",
            "command": "adb",
            "args": [
                "shell",
                "am",
                "start",
                "-n",
                "com.example.remotecu/.MainActivity"
            ],
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Android: Clean Build",
            "type": "shell",
            "command": "./gradlew.bat",
            "args": [
                "clean",
                "assembleDebug"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Android: Uninstall App",
            "type": "shell",
            "command": "./gradlew.bat",
            "args": [
                "uninstallDebug"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Android: List Connected Devices",
            "type": "shell",
            "command": "adb",
            "args": [
                "devices"
            ],
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Android: Full Workflow (Build + Install + Launch)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Android: Build and Install",
                "Android: Launch App"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        }
    ]
}
